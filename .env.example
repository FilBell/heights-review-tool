PORT=3000

# Okendo API key — get the current value from 1Password:
#   Heights Automations -> Okendo
# NEVER paste a real key into this file. A real one was committed
# here previously, in a PUBLIC repo.
OKENDO_API_KEY=your-okendo-store-key-here

# Slack Bot Token — required for Trustpilot reviews from #trustpilot_reviews
# Create a Slack app at https://api.slack.com/apps with scope: channels:history
# Then install to workspace and paste the Bot User OAuth Token here
SLACK_TOKEN=xoxb-your-token-here

# Anthropic API key — required for the "Campaign Match" feature
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cache TTL in minutes (default: 60)
CACHE_TTL_MINUTES=60
